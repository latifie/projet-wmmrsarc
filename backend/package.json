{
    "name": "backendsqlite",
    "version": "1.0.0",
    "description": "backendsqlite is the ultimate backend solution",
    "main": "src/server.js",
    "scripts": {
        "setup": "npm install && npm run doc && npm run updatedb",
        "updatedb": "rm -f ${DB:=bd.sqlite} && node src/util/updatedb.js",
        "doc": "node src/util/swagger.js",
        "build": "node build.js",
        "build:backend": "node build.js",
        "start": "node dist/server.js",
        "start:dev": "npm run doc && npm run updatedb && npx nodemon src/server.js",
        "startdev:proxyreact": "PROXYREACT=true npm run startdev",
        "test": "npm run doc && DB=bdtest.sqlite npm run updatedb && DB=bdtest.sqlite jest --env=node --coverage"
    },
    "keywords": [
        "express",
        "backend",
        "backendsqlite"
    ],
    "license": "UNLICENSED",
    "dependencies": {
        "axios": "^1.13.4",
        "bcrypt": "^5.0.1",
        "cheerio": "^1.2.0",
        "cookie-parser": "^1.4.4",
        "cors": "^2.8.5",
        "dockerode": "^4.0.9",
        "express": "^4.17.1",
        "express-custom-error": "^1.8.4",
        "has-keys": "^0.1.0",
        "helmet": "^3.21.2",
        "http-proxy-middleware": "^3.0.3",
        "http-status": "^1.3.2",
        "jsonwebtoken": "^9.0.3",
        "jws": "^4.0.0",
        "mandatoryenv": "^1.1.1",
        "mariadb": "^2.1.1",
        "module-alias": "^2.2.2",
        "morgan": "^1.9.1",
        "rotating-file-stream": "^1.4.6",
        "sequelize": "^6.35.2",
        "socket.io": "^4.8.3",
        "sqlite3": "^5.0.5",
        "swagger-autogen": "^2.18.8",
        "swagger-ui-express": "^4.3.0"
    },
    "devDependencies": {
        "esbuild": "^0.27.3",
        "eslint": "^7.32.0",
        "eslint-config-standard": "^16.0.3",
        "eslint-plugin-cypress": "^2.12.1",
        "eslint-plugin-import": "^2.25.4",
        "eslint-plugin-node": "^11.1.0",
        "eslint-plugin-promise": "^5.2.0",
        "fs-extra": "^11.3.3",
        "javascript-obfuscator": "^5.3.0",
        "jest": "^27.4.7",
        "jest-environment-node": "^27.5.1",
        "supertest": "^6.2.2"
    }
}